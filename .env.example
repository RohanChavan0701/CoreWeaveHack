# Copy to .env: every hgi command and the dashboard read ./.env before they run ($HGI_ENV_FILE names
# another file). An exported variable wins over this file; a variable left blank here reads as unset.

# The frozen model for a hand-run (hgi boot/evaluate/close): any OpenAI-compatible endpoint. CoreWeave inference
# endpoints are OpenAI-compatible; so is W&B Inference at https://api.inference.wandb.ai/v1, which takes the W&B API
# key and attributes usage to WANDB_ENTITY/<weave project>. An experiment file (hgi experiment run) names its own
# models and ignores these three.
HGI_INFERENCE_BASE_URL=https://<endpoint>/v1
HGI_INFERENCE_API_KEY=
HGI_MODEL_ID=

# The task suite for a hand-run: a TOML file with a [suite] table (families, size, seed, faults) — see hgi/world.py.
# Empty is the genesis family under the default fault profile. An experiment file names its own suite and ignores this.
HGI_SUITE=

# The oracle: W&B Weave. Leave HGI_WEAVE_PROJECT empty to run without tracing. WANDB_API_KEY may stay empty when
# `wandb login` has written the netrc entry; W&B Inference needs WANDB_ENTITY either way.
WANDB_ENTITY=
WANDB_API_KEY=
HGI_WEAVE_PROJECT=hgi

# TypeSafe AI System1, the machine-native adjudicator. Absent, the fallback context is used.
TYPESAFE_API_KEY=
