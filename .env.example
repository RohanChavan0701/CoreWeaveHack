# The frozen model: any OpenAI-compatible endpoint. CoreWeave inference endpoints are OpenAI-compatible.
HGI_INFERENCE_BASE_URL=https://<endpoint>/v1
HGI_INFERENCE_API_KEY=
HGI_MODEL_ID=

# The oracle: W&B Weave. Leave HGI_WEAVE_PROJECT empty to run without tracing.
WANDB_ENTITY=
HGI_WEAVE_PROJECT=hgi

# TypeSafe AI System1, the machine-native adjudicator. Absent, the fallback context is used.
TYPESAFE_API_KEY=
